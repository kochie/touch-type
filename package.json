    "electron-serve": "^3.0.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "10.3.0",
    "eslint-config-next": "16.2.6",
    "fathom-client": "^3.7.2",
    "formik": "^2.4.9",
    "idb": "^8.0.3",
    "lodash": "^4.18.1",
    "lodash.sample": "^4.2.1",
    "lodash.samplesize": "^4.2.0",
    "naughty-words": "^1.2.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "raw-loader": "^4.0.2",
    "react": "19.2.6",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.6",
    "react-error-boundary": "^6.1.1",
    "recharts": "^3.8.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "yup": "^1.7.1"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.8",
      "postcss": ">=8.5.10",
      "tmp": ">=0.2.4",
      "@tootallnate/once": ">=3.0.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "@sentry/cli",
      "esbuild"
    ]
  }
}
