{
  "name": "touch-typer",
  "description": "A cool little app to help your touch typing skills",
  "author": "Robert Koch <robert@kochie.io>",
  "main": "main/index.js",
  "productName": "Touch Typer",
  "version": "3.0.9",
  "files": [
    "main/",
    "renderer/out"
  ],
  "type": "commonjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "clean": "rimraf dist main renderer/out renderer/.next",
    "dev:next": "next dev renderer/",
    "dev": "npm run build-electron && electron .",
    "generate-licenses": "pnpm licenses list --prod --json | node -e \"const chunks=[]; process.stdin.on('data',d=>chunks.push(d)); process.stdin.on('end',()=>{ const raw=JSON.parse(Buffer.concat(chunks)); const out={}; for(const [lic,pkgs] of Object.entries(raw)) out[lic]=pkgs.map(p=>({name:p.name,version:(p.versions||[])[0]||'',homepage:p.homepage||'',author:p.author||''})); require('fs').writeFileSync('renderer/public/licenses.json',JSON.stringify(out,null,2)); console.log('Generated licenses.json'); });\"",
    "build-renderer": "next build renderer",
    "build-electron": "node esbuild.config.mjs",
    "build": "npm run generate-licenses && npm run build-renderer && npm run build-electron",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder -mlw",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json",
    "postinstall": "electron-builder install-app-deps",
    "replace-info": "sed -i '' 's/com.github.Electron/io.kochie.touch-typer/g' node_modules/electron/dist/Electron.app/Contents/Info.plist",
    "publish": "electron-builder -mlw -p always",
    "lint": "prettier --write .",
    "build+release": "electron-builder --config electron-builder.ts",
    "build+release:mac": "electron-builder --config electron-builder.ts --mac default --mac mas",
    "package:mac-unsigned": "electron-builder build --config electron-builder.ts --mac -c.mac.identity=null --publish never",
    "package:mac-mas-dev": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder build --config electron-builder.ts --mac mas-dev --publish never",
    "package:mac-default": "electron-builder build --config electron-builder.ts --mac default --publish never",
    "package:mac-default-dev": "MAC_DEV=true electron-builder build --config electron-builder.ts --mac default --publish never",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sentry/electron": "^7.13.0",
    "app-root-path": "^3.1.0",
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.3",
    "i18next": "^26.0.10",
    "module-details-from-path": "1.0.4",
    "ms": "2.1.3",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.4.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.2.0",
    "@fortawesome/pro-regular-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@next/mdx": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@sentry/core": "^10.52.0",
    "@sentry/nextjs": "^10.52.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/lodash.sample": "^4.2.9",
    "@types/lodash.samplesize": "^4.2.9",
    "@types/naughty-words": "^1.2.3",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uidotdev/usehooks": "^2.4.1",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "deepmerge": "^4.3.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^42.0.1",
    "electron-builder": "26.8.1",
    "electron-builder-notarize": "^1.5.2",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.3",
