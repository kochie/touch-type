# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (do not expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Account management link
NEXT_PUBLIC_ACCOUNT_LINK=https://your-billing-portal.com

# Website URL used by Supabase auth flows (password-reset magic link
# destination). Falls back to https://touch-typer.kochie.io when unset.
# Override for local dev (e.g. http://localhost:3000) or staging.
NEXT_PUBLIC_WEBSITE_URL=https://touch-typer.kochie.io
